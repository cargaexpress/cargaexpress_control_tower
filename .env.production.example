# ==============================================================================
# CargaExpress Supply Chain Control Tower
# Environment Configuration Template: PRODUCTION
# File: .env.production.example
# ==============================================================================
#
# IMPORTANT SECURITY NOTICE (ADR-0005 & Pydantic Production Validations):
# In production (APP_ENV=production), the application strictly enforces:
#   1. All API keys (API_KEY, ADMIN_API_KEY, BRAND_API_KEYS) must be AT LEAST
#      32 characters in length.
#   2. Keys MUST NOT start with 'change_me' (case-insensitive).
#   Failure to satisfy these constraints will cause container startup failure.
#
# Generate secure tokens using:
#   Linux/macOS: openssl rand -hex 32
#   PowerShell:  -join ((65..90) + (97..122) + (48..57) | Get-Random -Count 64 | % {[char]$_})
#
# In AWS ECS Fargate, secrets should NOT be baked into images or stored as plain text.
# Map these values from AWS Secrets Manager or SSM Parameter Store via the ECS
# task definition's "secrets" block.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION CORE RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
# Set to 'production' to enforce strict security validators and disable interactive /docs
APP_ENV=production

# Logging verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Disable SQL query echo in production to avoid log noise and credential leaks
SQL_ECHO=false

# Port on which the containerized FastAPI server listens
BACKEND_PORT=8000

# In-memory TTL cache duration for canonical state mappings (seconds, default: 300)
STATE_MAPPING_CACHE_TTL_SECONDS=300


# ------------------------------------------------------------------------------
# 2. RELATIONAL DATABASE (AMAZON RDS POSTGRESQL)
# ------------------------------------------------------------------------------
# Primary database connection URI for CargaExpress Backend & Consumer Worker.
# Format: postgresql+asyncpg://<USER>:<PASSWORD>@<RDS_ENDPOINT>:<PORT>/<DB_NAME>?ssl=require
# NOTE: Uses the 'postgresql+asyncpg://' scheme required by SQLAlchemy async engine.
DATABASE_URL=postgresql+asyncpg://cargaexpress_app:REPLACE_WITH_RDS_PASSWORD_AT_LEAST_32_CHARS@cargaexpress-prod-db.c12345678901.us-east-1.rds.amazonaws.com:5432/cargaexpress?ssl=require

# Optional fallback test database (leave unset or point to staging/test RDS instance)
# TEST_DATABASE_URL=postgresql+asyncpg://cargaexpress_test:REPLACE_WITH_TEST_RDS_PASSWORD@cargaexpress-prod-db.c12345678901.us-east-1.rds.amazonaws.com:5432/cargaexpress_test?ssl=require


# ------------------------------------------------------------------------------
# 3. MESSAGE BROKER (AMAZON MQ OR EC2 RABBITMQ)
# ------------------------------------------------------------------------------
# Broker connection URI for asynchronous webhook decoupling and Celery tasks.
# Format: amqps://<USER>:<PASSWORD>@<BROKER_HOST>:<PORT>/ (or amqp:// if inside private VPC)
RABBITMQ_URL=amqps://cargaexpress_broker:REPLACE_WITH_RABBITMQ_SECURE_PASSWORD@b-12345678-abcd.mq.us-east-1.amazonaws.com:5671/

# RabbitMQ Exchange and Queues topology configuration
RABBITMQ_EXCHANGE=eventos_exchange
RABBITMQ_QUEUE=eventos_transportadora
RABBITMQ_RETRY_QUEUE=eventos_transportadora.retry
RABBITMQ_DLQ_QUEUE=eventos_transportadora.dlq
RABBITMQ_RETRY_TTL_MS=5000
RABBITMQ_MAX_RETRIES=3
RABBITMQ_PREFETCH_COUNT=10


# ------------------------------------------------------------------------------
# 4. SECURITY & AUTHENTICATION TOKENS (STRICT PRODUCTION RULES)
# ------------------------------------------------------------------------------
# General API Key for consumer systems (>= 32 chars, cannot start with change_me)
# Example generation: openssl rand -hex 32
API_KEY=a7f9c84e1b0d235894fec18972109845ab34cd67ef890123456789abcdef0123

# Admin API Key for protected endpoints (state mappings, sync triggers, manual replay)
# Protected by ADR-0005. If empty, admin endpoints return 503.
ADMIN_API_KEY=b98e7d6c5a4b3c2d1e0f9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a0b9c8d

# Per-Brand API Keys JSON mapping: token -> brand_id
# Each key MUST be >= 32 chars and not start with 'change_me'
BRAND_API_KEYS={"9f8e7d6c5b4a3f2e1d0c9b8a7f6e5d4c3b2a1f0e9d8c7b6a5f4e3d2c1b0a9f8e": 1, "8a7b6c5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0a9b8c7d6e5f4a3b2c1d0e9f8a7b": 2}


# ------------------------------------------------------------------------------
# 5. CARRIER CONNECTORS & SIMULATORS (F3, F4, F5)
# ------------------------------------------------------------------------------
# Type A Simulator / Webhook Receiver Target URL
TYPE_A_SIMULATOR_URL=https://simulators.cargaexpress.internal/type-a
TYPE_A_MAX_RETRIES=3
TYPE_A_RETRY_BASE_DELAY_SECONDS=0.5

# Type B Carrier REST APIs Mapping JSON
TYPE_B_CARRIERS_URLS={"SimCarrier A": "https://carrier-a.partners.cargaexpress.internal", "SimCarrier B": "https://carrier-b.partners.cargaexpress.internal", "SimCarrier C": "https://carrier-c.partners.cargaexpress.internal", "SimCarrier D": "https://carrier-d.partners.cargaexpress.internal"}
TYPE_B_MAX_RETRIES=3
TYPE_B_RETRY_BASE_DELAY_SECONDS=0.5


# ------------------------------------------------------------------------------
# 6. APACHE AIRFLOW ORCHESTRATION (CELERY EXECUTOR & METASTORE)
# ------------------------------------------------------------------------------
# Airflow executor type in production
AIRFLOW__CORE__EXECUTOR=CeleryExecutor

# Airflow PostgreSQL metadata store database URL
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow_admin:REPLACE_WITH_AIRFLOW_DB_PASS_32_CHARS@cargaexpress-prod-db.c12345678901.us-east-1.rds.amazonaws.com:5432/airflow?sslmode=require

# Celery backend and broker connections
AIRFLOW__CELERY__RESULT_BACKEND=db+postgresql://airflow_admin:REPLACE_WITH_AIRFLOW_DB_PASS_32_CHARS@cargaexpress-prod-db.c12345678901.us-east-1.rds.amazonaws.com:5432/airflow?sslmode=require
AIRFLOW__CELERY__BROKER_URL=amqps://cargaexpress_broker:REPLACE_WITH_RABBITMQ_SECURE_PASSWORD@b-12345678-abcd.mq.us-east-1.amazonaws.com:5671//

# Fernet encryption key for sensitive Airflow connections/passwords.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=46BKJoQYlPPOexq0OhDZnIlNepKFf87WFwLbfzqJZPo=

# Production Airflow behavioral settings
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=true
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__API__AUTH_BACKENDS=airflow.api.auth.backend.basic_auth,airflow.api.auth.backend.session
AIRFLOW__SCHEDULER__MIN_FILE_PROCESS_INTERVAL=10
AIRFLOW__SCHEDULER__ENABLE_HEALTH_CHECK=true
AIRFLOW__WEBSERVER__WEB_SERVER_MASTER_TIMEOUT=300
AIRFLOW__WEBSERVER__WORKERS=2

# Internal endpoint for DAGs to communicate with the Control Tower backend API
CONTROL_TOWER_API_URL=http://cargaexpress-backend.internal:8000


# ------------------------------------------------------------------------------
# 7. AWS ENVIRONMENT IDENTIFIERS (FOR SCRIPTS AND CI/CD)
# ------------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com
ECS_CLUSTER=cargaexpress-production
ECS_BACKEND_SERVICE=cargaexpress-backend-service
ECS_WORKER_SERVICE=cargaexpress-worker-service
ECS_AIRFLOW_SERVICE=cargaexpress-airflow-service
