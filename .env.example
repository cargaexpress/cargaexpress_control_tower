# ==============================================================================
# CargaExpress Supply Chain Control Tower
# Environment Configuration Template (Local Development & Integration)
# File: .env.example
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DATABASE & CACHE
# ------------------------------------------------------------------------------
POSTGRES_USER=cargaexpress
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=cargaexpress
DB_PORT=5432
DATABASE_URL=postgresql+asyncpg://cargaexpress:change_me_local_only@localhost:5432/cargaexpress
TEST_DATABASE_URL=postgresql+asyncpg://cargaexpress:change_me_local_only@localhost:5432/cargaexpress_test

BACKEND_PORT=8000
APP_ENV=development
SQL_ECHO=false
LOG_LEVEL=INFO
STATE_MAPPING_CACHE_TTL_SECONDS=300

# ------------------------------------------------------------------------------
# 2. MESSAGE BROKER (RABBITMQ)
# ------------------------------------------------------------------------------
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=eventos_exchange
RABBITMQ_QUEUE=eventos_transportadora
RABBITMQ_RETRY_QUEUE=eventos_transportadora.retry
RABBITMQ_DLQ_QUEUE=eventos_transportadora.dlq

# ------------------------------------------------------------------------------
# 3. CONTROL TOWER SECURITY & API KEYS
# ------------------------------------------------------------------------------
ADMIN_API_KEY=change_me_admin_key_32_characters_minimum_local
API_KEY=change_me_api_key_32_characters_minimum_local
BRAND_API_KEYS={"brand_alpha_key_32_chars_long_local": 1, "brand_beta_key_32_chars_long_local": 2}
CARRIER_API_KEYS={"carrier_uno_key_32_chars_long_local": 1, "carrier_dos_key_32_chars_long_local": 2}

# Webhook Security (Carrier Tokens & HMAC Signature Verification)
WEBHOOK_SECRET=change_me_webhook_secret_32_chars_min
CARRIER_WEBHOOK_TOKENS={"simcarrier-alpha": "token_carrier_alpha_123", "simcarrier-beta": "token_carrier_beta_123", "simcarrier-gamma": "token_carrier_gamma_123", "simcarrier-delta": "token_carrier_delta_123", "simcarrier-epsilon": "token_carrier_epsilon_123"}

# ------------------------------------------------------------------------------
# 4. SIMULATOR INTEGRATIONS (DEPLOYED & EXTERNAL ENDPOINTS)
# ------------------------------------------------------------------------------
# Type A Simulator (Webhook Receiver & Autonomous Generator on EC2)
TYPE_A_SIMULATOR_URL=https://cargaexpress-simulator-b.mooo.com/sim-a
TYPE_A_MAX_RETRIES=3
TYPE_A_RETRY_BASE_DELAY_SECONDS=0.5

# Type B Carrier REST APIs (Live HTTPS Gateway)
TYPE_B_CARRIERS_URLS={"SimCarrier A": "https://cargaexpress-simulator-b.mooo.com/carrier-a", "SimCarrier B": "https://cargaexpress-simulator-b.mooo.com/carrier-b", "SimCarrier C": "https://cargaexpress-simulator-b.mooo.com/carrier-c", "SimCarrier D": "https://cargaexpress-simulator-b.mooo.com/carrier-d"}
TYPE_B_MAX_RETRIES=3
TYPE_B_RETRY_BASE_DELAY_SECONDS=0.5

# Type C Carriers Batch Downloads (Live HTTPS Gateway) & MinIO S3
TYPE_C_CARRIERS_URLS={"TransExpress Logistics": "https://cargaexpress-simulator-b.mooo.com/carrier-1", "Rapido Andino": "https://cargaexpress-simulator-b.mooo.com/carrier-2", "Logistica 360": "https://cargaexpress-simulator-b.mooo.com/carrier-3"}
TYPE_C_MAX_RETRIES=3
TYPE_C_RETRY_BASE_DELAY_SECONDS=0.5

# MinIO S3 Object Storage Credentials
MINIO_ENDPOINT=https://cargaexpress-simulator-b.mooo.com/minio
MINIO_ACCESS_KEY=cargaexpress_admin
MINIO_SECRET_KEY=cargaexpress_minio_secret_123
MINIO_BUCKET=type-c-carriers
