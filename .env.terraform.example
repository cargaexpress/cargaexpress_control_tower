# ==============================================================================
# CargaExpress - Terraform Environment Variables Configuration
# File: .env.terraform.example
# ==============================================================================
# Instructions:
# 1. Copy this file:
#      copy .env.terraform.example .env.terraform
# 2. Set your AWS IAM credentials.
# 3. Load them into your active shell session:
#      Windows (PowerShell): .\scripts\load_terraform_env.ps1
#      Linux / macOS (Bash): source ./scripts/load_terraform_env.sh
# 4. Terraform will automatically pick up all TF_VAR_* variables and AWS_* credentials!
# ==============================================================================

# AWS IAM Credentials & Target Region (Strictly us-east-2 Ohio)
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=us-east-2
AWS_DEFAULT_REGION=us-east-2

# Optional AWS Session Token (only if using Temporary Credentials or AWS SSO)
# AWS_SESSION_TOKEN=

# AWS Account ID (Optional: if blank, Terraform dynamically fetches it from the IAM caller identity)
TF_VAR_aws_account_id=

# Database & Broker Master Passwords (Optional: if blank, Terraform generates secure 24-char passwords)
TF_VAR_db_admin_password=
TF_VAR_rabbitmq_password=

# Project & Environment Settings
TF_VAR_project_name=cargaexpress
TF_VAR_aws_region=us-east-2
TF_VAR_environment=staging
TF_VAR_alert_email=devops-staging@cargaexpress.local
