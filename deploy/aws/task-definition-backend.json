{
  "family": "cargaexpress-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/cargaexpress-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/cargaexpress-backend-task-role",
  "containerDefinitions": [
    {
      "name": "cargaexpress-backend",
      "image": "<AWS_ACCOUNT_ID>.dkr.ecr.us-east-1.amazonaws.com/cargaexpress-backend:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "python -c \"import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:8000/api/v1/health', timeout=3).status == 200 else 1)\""
        ],
        "interval": 15,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 15
      },
      "environment": [
        {
          "name": "APP_ENV",
          "value": "production"
        },
        {
          "name": "LOG_LEVEL",
          "value": "INFO"
        },
        {
          "name": "SQL_ECHO",
          "value": "false"
        },
        {
          "name": "BACKEND_PORT",
          "value": "8000"
        },
        {
          "name": "STATE_MAPPING_CACHE_TTL_SECONDS",
          "value": "300"
        },
        {
          "name": "RABBITMQ_EXCHANGE",
          "value": "eventos_exchange"
        },
        {
          "name": "RABBITMQ_QUEUE",
          "value": "eventos_transportadora"
        },
        {
          "name": "RABBITMQ_RETRY_QUEUE",
          "value": "eventos_transportadora.retry"
        },
        {
          "name": "RABBITMQ_DLQ_QUEUE",
          "value": "eventos_transportadora.dlq"
        },
        {
          "name": "RABBITMQ_RETRY_TTL_MS",
          "value": "5000"
        },
        {
          "name": "RABBITMQ_MAX_RETRIES",
          "value": "3"
        },
        {
          "name": "RABBITMQ_PREFETCH_COUNT",
          "value": "10"
        },
        {
          "name": "TYPE_A_SIMULATOR_URL",
          "value": "https://simulators.cargaexpress.internal/type-a"
        },
        {
          "name": "TYPE_A_MAX_RETRIES",
          "value": "3"
        },
        {
          "name": "TYPE_A_RETRY_BASE_DELAY_SECONDS",
          "value": "0.5"
        },
        {
          "name": "TYPE_B_MAX_RETRIES",
          "value": "3"
        },
        {
          "name": "TYPE_B_RETRY_BASE_DELAY_SECONDS",
          "value": "0.5"
        }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:<AWS_ACCOUNT_ID>:secret:cargaexpress/production/database-url"
        },
        {
          "name": "RABBITMQ_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:<AWS_ACCOUNT_ID>:secret:cargaexpress/production/rabbitmq-url"
        },
        {
          "name": "API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:<AWS_ACCOUNT_ID>:secret:cargaexpress/production/api-key"
        },
        {
          "name": "ADMIN_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:<AWS_ACCOUNT_ID>:secret:cargaexpress/production/admin-api-key"
        },
        {
          "name": "BRAND_API_KEYS",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:<AWS_ACCOUNT_ID>:secret:cargaexpress/production/brand-api-keys"
        },
        {
          "name": "TYPE_B_CARRIERS_URLS",
          "valueFrom": "arn:aws:ssm:us-east-1:<AWS_ACCOUNT_ID>:parameter/cargaexpress/production/type-b-carriers-urls"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/cargaexpress-backend",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
